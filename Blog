let selectedTopic = '';

function selectTopic(btn, topic) {
  document.querySelectorAll('.topic-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  selectedTopic = topic;
  document.getElementById('custom-topic').value = '';
}

async function generatePost() {
  const customTopic = document.getElementById('custom-topic').value.trim();
  const topic = customTopic || selectedTopic;
  if (!topic) {
    document.getElementById('custom-topic').focus();
    return;
  }

  const btn = document.getElementById('generate-btn');
  const loading = document.getElementById('gen-loading');
  const output = document.getElementById('gen-output');

  btn.disabled = true;
  loading.style.display = 'block';
  output.style.display = 'none';

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: `You are Scott Nguyen, founder of Simple Consulting — a Canadian e-commerce and operations consultant with 15+ years of experience across Amazon, Walmart, Shopify, Google Ads, ERP systems, and Lean Six Sigma. Write a practical, authoritative blog post for business owners. Use a direct, no-fluff tone. Structure with a brief intro, 3-4 subheadings (using <h4> tags), and a closing action step. Use <p> tags for paragraphs. Keep it under 500 words. Do not include a title in the body — just the content. Make it genuinely useful and specific, not generic.`,
        messages: [{ role: 'user', content: `Write a blog post about: ${topic}` }]
      })
    });

    const data = await response.json();
    const text = data.content?.[0]?.text || '';

    // Generate a title
    const titleRes = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        messages: [{ role: 'user', content: `Write a compelling blog post title (max 12 words, no quotes) for an article about: ${topic}. Just the title, nothing else.` }]
      })
    });
    const titleData = await titleRes.json();
    const title = titleData.content?.[0]?.text?.trim() || topic;

    document.getElementById('gen-title').textContent = title;
    document.getElementById('gen-body').innerHTML = text;
    loading.style.display = 'none';
    output.style.display = 'block';

  } catch (err) {
    loading.style.display = 'none';
    btn.disabled = false;
    alert('Something went wrong generating the post. Please try again.');
  }

  btn.disabled = false;
}

function resetGenerator() {
  document.getElementById('gen-output').style.display = 'none';
  document.getElementById('custom-topic').value = '';
  selectedTopic = '';
  document.querySelectorAll('.topic-btn').forEach(b => b.classList.remove('active'));
}

function copyPost() {
  const title = document.getElementById('gen-title').textContent;
  const body = document.getElementById('gen-body').innerText;
  navigator.clipboard.writeText(`${title}\n\n${body}`).then(() => {
    const btn = document.querySelector('.btn-copy');
    btn.textContent = 'Copied!';
    setTimeout(() => btn.textContent = 'Copy Post', 2000);
  });
}

// ── STATIC POST MODAL ──
function openPost(index) {
  const post = posts[index];
  document.getElementById('modal-tag').textContent = post.tag;
  document.getElementById('modal-title').textContent = post.title;
  document.getElementById('modal-body').innerHTML = post.body;
  document.getElementById('modal-overlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closePost() {
  document.getElementById('modal-overlay').classList.remove('open');
  document.body.style.overflow = '';
}

function closePostIfOverlay(e) {
  if (e.target === document.getElementById('modal-overlay')) closePost();
}

document.addEventListener('keydown', e => { if (e.key === 'Escape') closePost(); });

// ── SCROLL REVEAL ──
const reveals = document.querySelectorAll('.reveal');
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
reveals.forEach(el => observer.observe(el));
</script>
